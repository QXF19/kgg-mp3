  "narrative": {
    "northStar": "A Quiet Music Workspace",
    "overview": "A restrained macOS-inspired visual world expresses the user's pinned Apple-like direction: pale neutrals, white work areas, charcoal Chinese typography, and precise blue actions. This is a Windows desktop application implemented in Java Swing with FlatLaf, not a macOS application, browser surface, iOS app, or Android app. Windows window management stays intact.\n\nCalm comes from tonal separation and generous spacing around task-dense controls. The real conversion queue remains central; styling must preserve local processing, source preservation, and the existing conversion workflow. This document records code evidence from MainFrame.java and GkkMp3App.java. Finish review covered empty and waiting queues at window widths 1200 and 1080; processing, completion, and failure layouts are code-observed rather than visually verified.",
    "keyCharacteristics": [
      "Quiet neutral surfaces with blue reserved for actions, selection, and progress.",
      "Readable Chinese system typography and a real, scrollable queue table.",
      "Rounded custom panels without painted shadows or decorative window chrome.",
      "Local-first desktop behavior and preserved Windows affordances."
    ],
    "rules": [
      {
        "name": "The Action Separation Rule",
        "body": "Do not conflate primary action blue, keyboard focus blue, and pale selected surfaces; their roles are distinct in the implementation.",
        "section": "colors"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Preserve flat, differentiated work areas; do not add decorative elevation to the queue or import surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the user's Apple-like visual direction while retaining Windows window management.",
      "Do use the observed palette and Microsoft YaHei UI hierarchy for new Swing controls.",
      "Do keep visible text status, usable keyboard focus, and file-state detail alongside color cues.",
      "Do preserve the local converter workflow and source-file safety.",
      "Do treat Java source as canonical when portable token previews differ from FlatLaf rendering."
    ],
    "donts": [
      "Don't represent this Windows Swing application as web, macOS, iOS, or Android.",
      "Don't add fake Apple traffic-light window controls or decorative glass to the native frame.",
      "Don't fabricate CSS breakpoints, custom control-state colors, or animation timings.",
      "Don't describe GPU detection as GPU MP3 encoding or imply audio uploads.",
      "Don't label procedural project icons as AI-generated assets."
    ]
  }
