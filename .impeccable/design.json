  "narrative": {
    "northStar": "Light Through the Music Workspace",
    "overview": "The user-selected Liquid Glass-inspired world uses procedural pale blue/violet light beneath translucent white panels, layered white rim highlights, and a pointer-responsive specular spot. Dark Chinese typography and restrained blue actions keep conversion controls readable. The rejected flat-light direction is superseded by this material language.\n\nThis remains a Windows Java Swing desktop application with FlatMacLightLaf controls and native Windows window management. Glass is drawn inside the app with Java2D alpha gradients and layered shapes: there is no macOS compositor integration, backdrop blur, optical refraction, or transparency to other desktop windows. The source is canonical; supplied previews cover 1200 × 820, 1080 × 820, and the 1080 × 740 minimum. A fresh finish review is handled separately.",
    "keyCharacteristics": [
      "Procedural blue/violet light fields and translucent white work panels.",
      "Thin layered white rims and pointer-responsive highlights.",
      "Readable Chinese type, a real queue table, and a distinct right-side inspector.",
      "Native Windows behavior and unchanged local audio conversion."
    ],
    "rules": [
      {
        "name": "The Action Separation Rule",
        "body": "Keep action, keyboard focus, selection, and ambient blue distinct; ambient light is not an interactive state.",
        "section": "colors"
      },
      {
        "name": "The Honest Glass Rule",
        "body": "Describe the implemented translucency and highlights, never unimplemented blur, optical refraction, or macOS compositor effects.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the user-selected Liquid Glass-inspired material rather than reverting to flat-light panels.",
      "Do keep dark readable Chinese text and clear blue conversion actions above the light fields.",
      "Do use the actual Java2D alpha, rim, and pointer-light behavior when extending glass panels.",
      "Do preserve native Windows window management, keyboard focus, visible text status, and local converter safety.",
      "Do treat Java source and FlatMacLightLaf rendering as canonical."
    ],
